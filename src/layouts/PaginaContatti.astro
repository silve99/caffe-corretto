---
import Base from './Base.astro';
import { SITO, SOCIAL } from '../config';
// Le pagine in Markdown passano titolo e descrizione nel frontmatter.
interface Props { titolo?: string; descrizione?: string; frontmatter?: { titolo?: string; descrizione?: string } }
const titolo = Astro.props.titolo ?? Astro.props.frontmatter?.titolo ?? '';
const descrizione = Astro.props.descrizione ?? Astro.props.frontmatter?.descrizione;
---
<Base titolo={titolo} descrizione={descrizione}>
  <article class="testo">
    <h1>{titolo}</h1>
    <slot />
    {SITO.emailContatti && (
      <p><strong>Email:</strong> <a href={`mailto:${SITO.emailContatti}`}>{SITO.emailContatti}</a></p>
    )}
    {SOCIAL.length > 0 && (
      <>
        <h2>Seguici</h2>
        <ul>
          {SOCIAL.map((s) => <li><a href={s.url} rel="noopener me">{s.nome}</a></li>)}
        </ul>
      </>
    )}
    {!SITO.emailContatti && SOCIAL.length === 0 && (
      <p>I contatti saranno disponibili a breve.</p>
    )}
  </article>
</Base>
