---
import Base from '../layouts/Base.astro';
import SchedaArticolo from '../components/SchedaArticolo.astro';
import { articoliPubblicati } from '../lib/articoli';
import { SITO, editore } from '../config';
import SchedaGuida from '../components/SchedaGuida.astro';
import { guidePubblicate, SEZIONE_GUIDE } from '../lib/guide';

const tutti = await articoliPubblicati();
const ultimoRiepilogo = tutti.find((a) => a.data.tipo === 'riepilogo' || a.data.tipo === 'settimanale');
const altri = tutti.filter((a) => a !== ultimoRiepilogo).slice(0, 12);
const guide = (await guidePubblicate()).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITO.nome,
      description: SITO.descrizione,
      inLanguage: SITO.lingua,
      url: new URL('/', Astro.site).toString(),
      publisher: { '@id': new URL('/#editore', Astro.site).toString() },
    },
    { ...editore(Astro.site), '@id': new URL('/#editore', Astro.site).toString() },
  ],
};
---
<Base jsonLd={jsonLd}>
  <h1 class="titolo-home">Notizie di Borsa, cripto ed economia del mattino</h1>
  <p class="meta">{SITO.descrizione}</p>
  {tutti.length === 0 && (
    <p class="vuoto">Il primo caffè è in preparazione: torna domani mattina alle 06:30.</p>
  )}
  <ul class="lista">
    {ultimoRiepilogo && <SchedaArticolo articolo={ultimoRiepilogo} evidenza />}
    {altri.map((a) => <SchedaArticolo articolo={a} />)}
  </ul>
  {tutti.length > 13 && <p><a href="/articoli/">Tutte le notizie →</a></p>}
  {guide.length > 0 && (
    <section class="sezione-guide">
      <h2>{SEZIONE_GUIDE.nome}</h2>
      <p class="meta intro">{SEZIONE_GUIDE.sottotitolo}</p>
      <ul class="lista">{guide.map((g) => <SchedaGuida guida={g} />)}</ul>
      <p><a href="/guide/">Tutte le guide →</a></p>
    </section>
  )}
</Base>
