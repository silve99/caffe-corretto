---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SchedaArticolo from '../../components/SchedaArticolo.astro';
import { articoliPubblicati, formatoData, etichettaTipo, type Articolo } from '../../lib/articoli';
import SchedaGuida from '../../components/SchedaGuida.astro';
import { guidePubblicate, SEZIONE_GUIDE, type Guida } from '../../lib/guide';
import { SITO, editore } from '../../config';

export async function getStaticPaths() {
  const tutti = await articoliPubblicati();
  const guide = await guidePubblicate();
  return tutti.map((articolo) => ({ params: { id: articolo.id }, props: { articolo, tutti, guide } }));
}
const { articolo, tutti, guide } = Astro.props as { articolo: Articolo; tutti: Articolo[]; guide: Guida[] };
const { titolo, descrizione, data, tipo, fonti, categorie } = articolo.data;
// Link interni automatici: altre notizie (prima quelle sugli stessi temi) e le guide collegate.
const altri = tutti.filter((a) => a.id !== articolo.id);
const stessoTema = (a: Articolo) => a.data.categorie.some((c) => categorie.includes(c));
const correlati = [...altri.filter(stessoTema), ...altri.filter((a) => !stessoTema(a))].slice(0, 3);
const TEMI_PER_CATEGORIA: Record<string, string[]> = {
  cripto: ['cripto'],
  azioni: ['azioni', 'etf-fondi'],
  macro: ['obbligazioni', 'risparmio', 'basi'],
  valute: ['basi', 'risparmio'],
  'materie-prime': ['basi'],
};
const temiUtili = new Set(categorie.flatMap((c) => TEMI_PER_CATEGORIA[c] ?? []));
// Le guide già citate nel testo non si ripetono.
const giaCitate = new Set([...(articolo.body ?? '').matchAll(/\(\/guide\/([a-z0-9-]+)\/?\)/g)].map((m) => m[1]));
const guideUtili = guide.filter((g) => !giaCitate.has(g.id));
const guideCorrelate = [...guideUtili.filter((g) => temiUtili.has(g.data.tema)), ...guideUtili.filter((g) => !temiUtili.has(g.data.tema))].slice(0, 2);
const { Content } = await render(articolo);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: titolo,
  description: descrizione,
  datePublished: data.toISOString(),
  dateModified: data.toISOString(),
  inLanguage: SITO.lingua,
  mainEntityOfPage: url,
  image: [new URL(SITO.immagineCondivisione, Astro.site).toString()],
  ...(categorie.length ? { keywords: categorie.join(', ') } : {}),
  author: { '@type': 'Organization', name: 'Redazione ' + SITO.nome, url: new URL('/chi-siamo/', Astro.site).toString() },
  publisher: editore(Astro.site),
};
const briciole = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITO.nome, item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Notizie', item: new URL('/articoli/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: titolo, item: url },
  ],
};
---
<Base titolo={titolo} descrizione={descrizione} tipoOg="article" jsonLd={{ '@context': 'https://schema.org', '@graph': [jsonLd, briciole] }} pubblicato={data} modificato={data}>
  <article class="testo">
    <p class="briciole"><a href="/articoli/">Notizie</a> › {etichettaTipo[tipo] ?? tipo}</p>
    <h1>{titolo}</h1>
    <p class="meta">
      <time datetime={data.toISOString()}>{formatoData(data)}</time> · Redazione {SITO.nome}
    </p>
    <Content />
    {fonti.length > 0 && (
      <section class="fonti">
        <strong>Fonti</strong>
        <ul>{fonti.map((f) => <li><a href={f.url} rel="nofollow noopener" target="_blank">{f.nome}</a></li>)}</ul>
      </section>
    )}
    <p class="fonti">
      Questo articolo è preparato con l'aiuto dell'intelligenza artificiale a partire da fonti pubbliche
      e ha solo scopo informativo: non è una consulenza finanziaria. <a href="/come-lavoriamo/">Come lavoriamo</a>.
    </p>
  </article>
  {guideCorrelate.length > 0 && (
    <section>
      <h2>Per capire meglio</h2>
      <p class="meta">Le guide di {SEZIONE_GUIDE.nome}, spiegate con calma.</p>
      <ul class="lista">{guideCorrelate.map((g) => <SchedaGuida guida={g} />)}</ul>
    </section>
  )}
  {correlati.length > 0 && (
    <section>
      <h2>Altre notizie</h2>
      <ul class="lista">{correlati.map((a) => <SchedaArticolo articolo={a} />)}</ul>
    </section>
  )}
</Base>
